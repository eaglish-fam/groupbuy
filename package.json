{
  "name": "groupbuy",
  "private": true,
  "version": "1.0.0",
  "description": "鷹家 Fun 生買物社 - 團購頁",
  "scripts": {
    "build:homepage": "node scripts/build-homepage.mjs",
    "build:trip": "node scripts/build-trip.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "normalize:blog-seo": "node scripts/normalize-blog-seo.mjs --write --touch-date",
    "check:blog-seo": "node scripts/normalize-blog-seo.mjs",
    "audit:site": "node scripts/site-maintenance-audit.mjs --write",
    "audit:blog": "node scripts/blog-release-audit.mjs --write",
    "build:css": "tailwindcss -i src/tailwind-input.css -o tailwind.css --minify",
    "flight:preflight": "node flights-pipeline/src/cli.mjs preflight",
    "flight:indicative": "node flights-pipeline/src/cli.mjs indicative",
    "flight:live": "node flights-pipeline/src/cli.mjs live",
    "flight:scan": "node flights-pipeline/src/cli.mjs scan",
    "test": "node --test tests/*.test.mjs",
    "plan:seo": "node scripts/seo-performance-plan.mjs",
    "verify": "npm run build:homepage && npm run build:trip && npm run build:css && npm run build:sitemap && npm run check:blog-seo && npm run audit:site && npm run audit:blog && npm test",
    "watch:css": "tailwindcss -i src/tailwind-input.css -o tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
