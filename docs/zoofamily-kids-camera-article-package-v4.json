  "technicalSeo": {
    "author": {
      "type": "Organization",
      "name": "鷹式一家",
      "url": "https://www.eaglish.store/"
    },
    "datePublished": "2026-11-06",
    "dateModified": "2026-11-06",
    "social": {
      "ogImage": "https://www.eaglish.store/assets/zoofamily-kids-camera/cover.webp",
      "ogImageAlt": "ZooFamily 兒童相機，四款怎麼選",
      "width": 1600,
      "height": 1000,
      "twitterCard": "summary_large_image",
      "shareImage": "https://www.eaglish.store/assets/zoofamily-kids-camera/share.webp",
