  "claims": [
    {
      "id": "brand",
      "text": "丹麥設計、設計師姓氏與品牌名稱關係及跨品類角色，以原廠說明為依據。",
      "type": "confirmed_product_fact",
      "sourceIds": [
        "brand-story",
        "brand-friends",
        "designer-interview"
      ]
    },
    {
      "id": "silicone",
      "text": "本篇三款碗盤、餐墊、學習匙及Sheepy禮盒的材質、尺寸、耐熱與照護，按各自台灣代理商頁標示；認證以代理商的標示歸屬。",
      "type": "vendor_claim",
      "sourceIds": [
        "product-01",
        "product-02",
        "product-04",
        "product-05",
        "product-06",
        "product-13"
      ]
    },
    {
      "id": "travel",
      "text": "容量、尺寸、台灣耐熱標示、保溫最長6小時、包袋搭配及照護，逐款以所引商品頁為依據；280ml只寫雙方均支持的塑膠瓶身，不裁決樹脂版本。",
      "type": "confirmed_product_fact",
      "sourceIds": [
        "product-03",
        "product-07",
        "product-08",
        "product-09",
        "product-10",
        "product-11"
      ]
    },
    {
      "id": "straw-age-care",
      "text": "兩款已對應SKU吸管瓶原廠建議6個月以上；保溫罐壺不建議洗碗機與冷凍。",
      "type": "confirmed_product_fact",
      "sourceIds": [
        "manufacturer-03",
        "manufacturer-07",
        "manufacturer-08"
      ]
    },
    {
      "id": "rattle",
      "text": "粉色三件組的2–4、3–5、4–6月階段為代理商逐件說明；獎項句刪除，不宣稱主辦方名單已核實。",
      "type": "vendor_claim",
      "sourceIds": [
        "product-12"
      ]
    }
  ],
