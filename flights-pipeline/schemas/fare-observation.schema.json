{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.eaglish.store/schemas/fare-observation.schema.json",
  "title": "Fare observation",
  "type": "object",
  "required": [
    "observationId", "fareKey", "provider", "providerResultId", "searchKind",
    "observedAt", "origin", "destination", "outboundDate", "adults",
    "cabinClass", "currency", "priceAmount", "isDirect", "freshness", "complete"
  ],
  "properties": {
    "observationId": { "type": "string" },
    "fareKey": { "type": "string" },
    "provider": { "type": "string" },
    "providerResultId": { "type": "string" },
    "searchKind": { "enum": ["indicative", "live"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "origin": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "destination": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "outboundDate": { "type": "string", "format": "date" },
    "inboundDate": { "type": ["string", "null"], "format": "date" },
    "adults": { "type": "integer", "minimum": 1, "maximum": 8 },
    "cabinClass": { "type": "string" },
    "currency": { "type": "string" },
    "priceAmount": { "type": "number", "exclusiveMinimum": 0 },
    "priceUnit": { "type": ["string", "null"] },
    "isDirect": { "type": ["boolean", "null"] },
    "carrier": { "type": ["string", "null"] },
    "bookingUrl": { "type": ["string", "null"] },
    "freshness": { "type": "string" },
    "complete": { "type": "boolean" }
  },
  "additionalProperties": true
}
